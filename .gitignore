# Vim.gitignore

# Swap
[._]*.s[a-v][a-z]
!*.svg  # comment out if you don't need vector files
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Session
Session.vim
Sessionx.vim

# Temporary
.netrwhist
*~
# Auto-generated tag files
tags
# Persistent undo
[._]*.un~

.DS_Store

*.tfplan

errored.tfstate
.terraform
terraform.tfstate.backup
terraform.tfstate.*.backup
plan.tfplan
plan.txt
output.json
*.log

*.pyc
__pycache__/

# https://mise.jdx.dev/configuration.html
# https://mise.jdx.dev/configuration/environments.html
.mise.*.local.toml
.mise.local.toml
mise.*.local.toml
mise.local.toml
.mise/*.local.toml
mise/*.local.toml

# https://mise.jdx.dev/dev-tools/mise-lock.html#local-lockfiles
# https://mise.jdx.dev/dev-tools/mise-lock.html#environment-specific-lockfiles
mise.local.lock
mise.*.local.lock
